<?xml version="1.0"?>
<robot name="myrobot">

  <!-- ============ Materials ============ -->
  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>

  <material name="red">
    <color rgba="0.8 0 0 1"/>
  </material>

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <!-- ============ Body ============ -->
  <link name="base_link">
    <!-- visual of the body -->
    <visual>
      <geometry>
        <box size="0.3 0.2 0.08"/>
      </geometry>
      <material name="white"/>
    </visual>

    <!-- visual of the lights, to indicate which side is front -->
    <visual>
      <origin xyz="0.15 0.06 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.02"/>
      </geometry>
      <material name="red"/>
    </visual>

    <visual>
      <origin xyz="0.15 -0.06 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.02"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.3 0.2 0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.00773" ixy="0" ixz="0"
              iyy="0.01607" iyz="0"
              izz="0.02167"/>
    </inertial>
  </link>

  <!-- ============ Left front wheel ============ -->
  <link name="left_front_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000152" ixy="0" ixz="0"
              iyy="0.00025" iyz="0"
              izz="0.000152"/>
    </inertial>
  </link>

  <joint name="left_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_front_wheel_link"/>
    <origin xyz="0.1 0.12 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ============ Left back wheel ============ -->
  <link name="left_back_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000152" ixy="0" ixz="0"
              iyy="0.00025" iyz="0"
              izz="0.000152"/>
    </inertial>
  </link>

  <joint name="left_back_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_back_wheel_link"/>
    <origin xyz="-0.1 0.12 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ============ Right front wheel ============ -->
  <link name="right_front_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000152" ixy="0" ixz="0"
              iyy="0.00025" iyz="0"
              izz="0.000152"/>
    </inertial>
  </link>

  <joint name="right_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_front_wheel_link"/>
    <origin xyz="0.1 -0.12 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ============ Right back wheel ============ -->
  <link name="right_back_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000152" ixy="0" ixz="0"
              iyy="0.00025" iyz="0"
              izz="0.000152"/>
    </inertial>
  </link>

  <joint name="right_back_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_back_wheel_link"/>
    <origin xyz="-0.1 -0.12 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  
  <!-- link to be used as the origin so that it is off the ground / origin (to fix warning)-->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  
  <gazebo>
    <!--publishes the simulated angle of every joint, so ROS can build the wheel TF frames   -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
    
    <!-- Listens for velocity commands, spins the wheels, and publishes odometry -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_front_wheel_joint</left_joint>
      <left_joint>left_back_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <right_joint>right_back_wheel_joint</right_joint>

      <!-- distance between the left and right wheel centers-->
      <wheel_separation>0.24</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      
      <!-- Gazebo-side topic names (the bridge will connect these to ROS topics) -->
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <!--  Frame names used in the odometry and the odom -> base TF -->
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

</robot>
