<?xml version="1.0"?>
<robot name="myrobot">

  <!-- ============ Materials ============ -->
  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>

  <material name="red">
    <color rgba="0.8 0 0 1"/>
  </material>

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <!-- ============ Body ============ -->
  <link name="base_link">
    <!-- visual of the body -->
    <visual>
      <geometry>
        <box size="0.3 0.2 0.08"/>
      </geometry>
      <material name="white"/>
    </visual>

    <!-- visual of the lights, to indicate which side is front -->
    <visual>
      <origin xyz="0.15 0.06 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.02"/>
      </geometry>
      <material name="red"/>
    </visual>

    <visual>
      <origin xyz="0.15 -0.06 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.02"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.3 0.2 0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.00773" ixy="0" ixz="0"
              iyy="0.01607" iyz="0"
              izz="0.02167"/>
    </inertial>
  </link>

  <!-- ============ Left drive wheel (centered on the body's x axis) ============ -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000152" ixy="0" ixz="0"
              iyy="0.00025" iyz="0"
              izz="0.000152"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.12 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ============ Right drive wheel ============ -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000152" ixy="0" ixz="0"
              iyy="0.00025" iyz="0"
              izz="0.000152"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.12 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ============ Front caster (passive ball, slides freely) ============ -->
  <link name="front_caster_link">
    <visual>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="caster_gray">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000125" ixy="0" ixz="0"
              iyy="0.0000125" iyz="0"
              izz="0.0000125"/>
    </inertial>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="0.12 0 -0.025" rpy="0 0 0"/>
  </joint>

  <!-- ============ Back caster ============ -->
  <link name="back_caster_link">
    <visual>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="caster_gray_back">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000125" ixy="0" ixz="0"
              iyy="0.0000125" iyz="0"
              izz="0.0000125"/>
    </inertial>
  </link>

  <joint name="back_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="back_caster_link"/>
    <origin xyz="-0.12 0 -0.025" rpy="0 0 0"/>
  </joint>

  <!-- link to be used as the origin so that it is off the ground / origin (to fix warning)-->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>


  <!-- ============ lidar link ============ -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0000608" ixy="0" ixz="0" iyy="0.0000608" iyz="0" izz="0.00008"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.065" rpy="0 0 0"/>
  </joint>


  <!-- ============ camera link ============ -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.06 0.03"/>
      </geometry>
      <material name="camera_green">
        <color rgba="0.1 0.6 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.06 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001875" ixy="0" ixz="0" iyy="0.0000054" iyz="0" izz="0.00001667"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.16 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- gazebo section -->

  <!-- Casters should slide freely: zero friction (this tag may be ignored; see spin test) -->
  <gazebo reference="front_caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo reference="back_caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo>
    <!--publishes the simulated angle of every joint, so ROS can build the wheel TF frames   -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    <!-- https://gazebosim.org/api/gazebo/6/classignition_1_1gazebo_1_1systems_1_1JointStatePublisher.html-->
      <topic>joint_states</topic>
    </plugin>

    <!-- Listens for velocity commands, spins the wheels, and publishes odometry -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
    <!-- https://gazebosim.org/api/gazebo/6/classignition_1_1gazebo_1_1systems_1_1DiffDrive.html-->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- distance between the left and right wheel centers (physical value, no slip fudge) -->
      <wheel_separation>0.24</wheel_separation>
      <wheel_radius>0.05</wheel_radius>

      <!-- Gazebo-side topic names (the bridge will connect these to ROS topics) -->
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <!--  Frame names used in the odometry and the odom -> base TF -->
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

  <!-- attach the sensor to this lidar_link -->
  <gazebo reference="lidar_link">
    <!-- declares a lidar sensor-->
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>lidar_link</gz_frame_id>
      <!-- name of the topic-->
      <topic>scan</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <gz_frame_id>camera_link</gz_frame_id>
      <!-- The image_raw name is the ROS convention for an unprocessed image.-->
      <topic>camera/image_raw</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>
