<?xml version="1.0"?>
<robot name="myrobot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ Properties ============ -->
  <!-- 90 degree rotation. Deliberately 1.5708 and not ${pi/2}: a wheel collision cylinder lying exactly flat
       gives Gazebo an unstable ground contact and the wheels slip (see Known limitations in the README) -->
  <xacro:property name="quarter_turn" value="1.5708"/>

  <!-- body -->
  <xacro:property name="base_length" value="0.3"/>
  <xacro:property name="base_width" value="0.2"/>
  <xacro:property name="base_height" value="0.08"/>
  <xacro:property name="base_mass" value="2.0"/>

  <!-- drive wheels, mounted flush against the sides of the body -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.2"/>
  <xacro:property name="wheel_separation" value="${base_width + wheel_width}"/>

  <!-- casters, placed so their bottom touches the ground at the same height as the wheels -->
  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass" value="0.05"/>
  <xacro:property name="caster_x_offset" value="0.12"/>
  <xacro:property name="caster_z_offset" value="${caster_radius - wheel_radius}"/>

  <!-- front lights -->
  <xacro:property name="light_radius" value="0.02"/>
  <xacro:property name="light_length" value="0.02"/>
  <xacro:property name="light_y_offset" value="0.06"/>

  <!-- lidar, sits on top of the body -->
  <xacro:property name="lidar_radius" value="0.04"/>
  <xacro:property name="lidar_length" value="0.05"/>
  <xacro:property name="lidar_mass" value="0.1"/>

  <!-- camera, mounted on the front face of the body -->
  <xacro:property name="camera_depth" value="0.02"/>
  <xacro:property name="camera_width" value="0.06"/>
  <xacro:property name="camera_height" value="0.03"/>
  <xacro:property name="camera_mass" value="0.05"/>
  <xacro:property name="camera_z_offset" value="0.02"/>

  <!-- ============ Materials ============ -->
  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>

  <material name="red">
    <color rgba="0.8 0 0 1"/>
  </material>

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <!-- ============ Macros ============ -->
  <!-- inertia of a solid box with mass m and side lengths x, y, z, centered on the link origin -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y + z*z)/12}" ixy="0" ixz="0"
              iyy="${m*(x*x + z*z)/12}" iyz="0"
              izz="${m*(x*x + y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <!-- the robot body (base_link), with two front lights to indicate which side is front -->
  <xacro:macro name="body" params="length width height mass">
    <link name="base_link">
      <!-- visual of the body -->
      <visual>
        <geometry>
          <box size="${length} ${width} ${height}"/>
        </geometry>
        <material name="white"/>
      </visual>

      <!-- visual of the lights, to indicate which side is front -->
      <visual>
        <origin xyz="${length/2} ${light_y_offset} 0" rpy="0 ${quarter_turn} 0"/>
        <geometry>
          <cylinder radius="${light_radius}" length="${light_length}"/>
        </geometry>
        <material name="red"/>
      </visual>

      <visual>
        <origin xyz="${length/2} ${-light_y_offset} 0" rpy="0 ${quarter_turn} 0"/>
        <geometry>
          <cylinder radius="${light_radius}" length="${light_length}"/>
        </geometry>
        <material name="red"/>
      </visual>

      <collision>
        <geometry>
          <box size="${length} ${width} ${height}"/>
        </geometry>
      </collision>

      <xacro:box_inertia m="${mass}" x="${length}" y="${width}" z="${height}"/>
    </link>
  </xacro:macro>

  <!-- Wheel macros -->
  <xacro:macro name="wheel_link" params="side_name">
    <link name="${side_name}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${quarter_turn} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="blue"/>
      </visual>

      <!-- uses quarter_turn (1.5708), not ${pi/2}: see the note on quarter_turn -->
      <collision>
        <origin xyz="0 0 0" rpy="${quarter_turn} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <!-- solid cylinder whose axis runs along y (the spin axis), so iyy gets the m*r^2/2 term -->
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}" ixy="0" ixz="0"
                iyy="${wheel_mass*wheel_radius*wheel_radius/2}" iyz="0"
                izz="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="wheel_joint" params="side_name parent_link y_origin">
    <joint name="${side_name}_wheel_joint" type="continuous">
      <parent link="${parent_link}"/>
      <child link="${side_name}_wheel_link"/>
      <origin xyz="0 ${y_origin} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- caster macros -->
  <xacro:macro name="caster_link" params="side_name">
    <link name="${side_name}_caster_link">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="caster_gray">
          <color rgba="0.3 0.3 0.3 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>

      <!-- solid sphere: the same 2/5*m*r^2 about every axis -->
      <inertial>
        <mass value="${caster_mass}"/>
        <inertia ixx="${2*caster_mass*caster_radius*caster_radius/5}" ixy="0" ixz="0"
                iyy="${2*caster_mass*caster_radius*caster_radius/5}" iyz="0"
                izz="${2*caster_mass*caster_radius*caster_radius/5}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="caster_joint" params="side_name parent_link x_origin">
    <joint name="${side_name}_caster_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${side_name}_caster_link"/>
      <origin xyz="${x_origin} 0 ${caster_z_offset}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- footprint macro -->
  <!-- link to be used as the origin so that it is off the ground / origin (to fix warning)-->
  <xacro:macro name="footprint" params="child_link">
    <link name="base_footprint"/>

    <!-- the wheel axles are level with the body's center, so lift the body by one wheel radius -->
    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="${child_link}"/>
      <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- lidar macros -->
  <xacro:macro name="lidar_link" params="">
    <link name="lidar_link">
      <visual>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
        </geometry>
        <material name="lidar_black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
        </geometry>
      </collision>

      <!-- solid cylinder standing upright, axis along z, so izz gets the m*r^2/2 term -->
      <inertial>
        <mass value="${lidar_mass}"/>
        <inertia ixx="${lidar_mass*(3*lidar_radius*lidar_radius + lidar_length*lidar_length)/12}" ixy="0" ixz="0"
                iyy="${lidar_mass*(3*lidar_radius*lidar_radius + lidar_length*lidar_length)/12}" iyz="0"
                izz="${lidar_mass*lidar_radius*lidar_radius/2}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- the lidar sits on top of the parent link -->
  <xacro:macro name="lidar_joint" params="parent_link">
    <joint name="lidar_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="lidar_link"/>
      <origin xyz="0 0 ${base_height/2 + lidar_length/2}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- camera macros -->
  <xacro:macro name="camera_link" params="">
    <link name="camera_link">
      <visual>
        <geometry>
          <box size="${camera_depth} ${camera_width} ${camera_height}"/>
        </geometry>
        <material name="camera_green">
          <color rgba="0.1 0.6 0.1 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="${camera_depth} ${camera_width} ${camera_height}"/>
        </geometry>
      </collision>

      <xacro:box_inertia m="${camera_mass}" x="${camera_depth}" y="${camera_width}" z="${camera_height}"/>
    </link>
  </xacro:macro>

  <!-- the camera is mounted on the front face of the parent link -->
  <xacro:macro name="camera_joint" params="parent_link">
    <joint name="camera_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="camera_link"/>
      <origin xyz="${base_length/2 + camera_depth/2} 0 ${camera_z_offset}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- ============ Footprint ============ -->
  <xacro:footprint child_link="base_link"/>

  <!-- ============ Body ============ -->
  <xacro:body length="${base_length}" width="${base_width}" height="${base_height}" mass="${base_mass}"/>

  <!-- ============ left drive wheel ============ -->
  <xacro:wheel_link side_name="left"/>
  <xacro:wheel_joint side_name="left" parent_link="base_link" y_origin="${wheel_separation/2}"/>

  <!-- ============ Right drive wheel ============ -->
  <xacro:wheel_link side_name="right"/>
  <xacro:wheel_joint side_name="right" parent_link="base_link" y_origin="${-wheel_separation/2}"/>

  <!-- ============ front caster ============ -->
  <xacro:caster_link side_name="front"/>
  <xacro:caster_joint side_name="front" parent_link="base_link" x_origin="${caster_x_offset}"/>

  <!-- ============ back caster ============ -->
  <xacro:caster_link side_name="back"/>
  <xacro:caster_joint side_name="back" parent_link="base_link" x_origin="${-caster_x_offset}"/>

  <!-- ============ lidar ============ -->
  <xacro:lidar_link/>
  <xacro:lidar_joint parent_link="base_link"/>

  <!-- ============ camera ============ -->
  <xacro:camera_link/>
  <xacro:camera_joint parent_link="base_link"/>

  <!-- gazebo section -->

  <!-- Casters should slide freely: zero friction (this tag may be ignored; see spin test) -->
  <gazebo reference="front_caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo reference="back_caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo>
    <!--publishes the simulated angle of every joint, so ROS can build the wheel TF frames   -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    <!-- https://gazebosim.org/api/gazebo/6/classignition_1_1gazebo_1_1systems_1_1JointStatePublisher.html-->
      <topic>joint_states</topic>
    </plugin>

    <!-- Listens for velocity commands, spins the wheels, and publishes odometry -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
    <!-- https://gazebosim.org/api/gazebo/6/classignition_1_1gazebo_1_1systems_1_1DiffDrive.html-->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- distance between the left and right wheel centers (physical value, no slip fudge) -->
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <!-- Gazebo-side topic names (the bridge will connect these to ROS topics) -->
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <!--  Frame names used in the odometry and the odom -> base TF -->
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

  <!-- attach the sensor to this lidar_link -->
  <gazebo reference="lidar_link">
    <!-- declares a lidar sensor-->
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>lidar_link</gz_frame_id>
      <!-- name of the topic-->
      <topic>scan</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <gz_frame_id>camera_link</gz_frame_id>
      <!-- The image_raw name is the ROS convention for an unprocessed image.-->
      <topic>camera/image_raw</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>
